# ---- Database (Supabase / Postgres) ----
DATABASE_PASSWORD=your_db_password

# Transaction-mode pooler — used for all app queries
DATABASE_URL="postgresql+asyncpg://postgres.<project>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — used for Alembic migrations only
DIRECT_URL="postgresql+asyncpg://postgres.<project>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ---- LLM: Ollama Cloud (primary) ----
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_MODEL=gemma4:31b

# ---- LLM: Groq (fallback) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- JWT ----
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- SMTP — Gmail ----
# Use a Gmail App Password, NOT your account password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_gmail@gmail.com
RESET_TOKEN_EXPIRE_MINUTES=30

# ---- App ----
APP_ENV=development
FRONTEND_URL=http://localhost:5173
