[Unit]
Description=PostWeek FastAPI Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/postweek/backend
EnvironmentFile=/home/ubuntu/postweek/backend/.env
ExecStart=/home/ubuntu/postweek/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
